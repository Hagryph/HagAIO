## Interface: 120005
## Title: HagAIO
## Notes: All-in-One toolkit for World of Warcraft (Midnight)
## Author: Hagryph
## Version: 0.1.0
## SavedVariables: HagAIODB
## SavedVariablesPerCharacter: HagAIOCharDB
## IconTexture: Interface\AddOns\HagAIO\Media\icon
## X-Website: https://github.com/Hagryph/HagAIO
## X-Category: Combat
## AllowLoadGameType: retail

# Interface 120005 = patch 12.0.5 (current live, Midnight). Bump to 120007
# once 12.0.7 "Revelations" goes live (2026-06-16).

# --- foundation (plain libraries + core singletons) ---
Core\Namespace.lua
Core\Class.lua
Core\Theme.lua
# DependencyGraph + Logger are core (used by/needed before the service layer).
# Service/ServiceManager + ModuleManager self-instantiate at load.
Core\DependencyGraph.lua
Core\Logger.lua
# Registry: shared base for the three lifecycle managers below.
Core\Registry.lua
# Component loads before Service: Service borrows Component's shared logging surface.
Core\Component.lua
Core\Service.lua
Core\ServiceManager.lua
Core\Module.lua
Core\ModuleManager.lua
Core\Submodule.lua
Core\SubmoduleManager.lua

# --- services (top-level Services/; each self-registers with the ServiceManager;
#     order here is irrelevant -- the ServiceManager resolves load order from deps) ---
Services\Cache.lua
Services\Memoize.lua
Services\Scheduler.lua
Services\Serializer.lua
Services\Profiles.lua
# pure-logic helpers (no WoW API; extracted from modules so they're unit-testable)
Services\FlightGraph.lua
Services\Geometry.lua
Services\SpellTooltipParser.lua
Services\CVarHelper.lua
Services\EventBus.lua
Services\SavedVars.lua
Services\SlashCommand.lua
Services\Hooks.lua
Services\ActionBars.lua
Services\Range.lua
Services\Cooldowns.lua
Services\Secrets.lua
Services\Scaling.lua
Services\Dev.lua
Services\EditMode.lua
Services\Compartment.lua
Services\MinimapIcon.lua

# --- UI (Widgets is a static factory; the windows are UI services) ---
UI\Widgets.lua
UI\CopyWindow.lua
UI\SettingsWindow.lua

# Core initializer: one StartAll() boots every service in dependency order, then
# wires the runtime startup. Loads after the services/UI, before the modules.
Core\Init.lua
Modules\Questing.lua
Modules\UnitFrames.lua
Modules\Class.lua
Modules\Class\Monk.lua
Modules\Misc.lua
Modules\CVars.lua
Modules\Tasklist.lua
Modules\Collection.lua
Modules\Collection\ATT.lua
